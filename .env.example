# Local development sample values only. Copy to .env for local use.
NODE_ENV=development

# API
API_PORT=3000
API_HOST_PORT=3001
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=joia-development-access-token-secret-change-before-production
JWT_ISSUER=joia-api
JWT_AUDIENCE=joia-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
PASSWORD_RESET_TTL_MINUTES=15

# SMTP is optional locally. When SMTP_HOST is set, the API sends only authentication
# password recovery emails through this adapter.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@joia.local

# Web
WEB_HOST_PORT=5173
VITE_API_BASE_URL=http://localhost:3001

# PostgreSQL / Prisma
POSTGRES_DB=joia_dev
POSTGRES_USER=joia
POSTGRES_PASSWORD=joia_dev_password
POSTGRES_PORT=55432
DATABASE_URL=postgresql://joia:joia_dev_password@localhost:55432/joia_dev?schema=public
