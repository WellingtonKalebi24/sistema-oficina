generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model FoundationCheck {
  id        String   @id @default(cuid())
  label     String   @unique
  status    String   @default("recorded")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("foundation_checks")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  document  String?  @unique
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  settings                     CompanySetting?
  users                        User[]
  roles                        Role[]
  sessions                     Session[]
  auditLogs                    AuditLog[]
  customers                    Customer[]
  vehicles                     Vehicle[]
  customerVehicleHistoryEvents CustomerVehicleHistoryEvent[]
  serviceCatalogEntries        ServiceCatalogEntry[]
  productCategories            ProductCategory[]
  products                     Product[]
  productStocks                ProductStock[]
  suppliers                    Supplier[]
  purchases                    Purchase[]
  purchaseItems                PurchaseItem[]
  stockMovements               StockMovement[]
  stockReservations            StockReservation[]
  appointments                 Appointment[]
  receptionCheckIns            ReceptionCheckIn[]
  receptionChecklistItems      ReceptionChecklistItem[]
  checkInAttachments           CheckInAttachment[]

  @@index([status])
  @@map("tenants")
}

model CompanySetting {
  id           String   @id @default(cuid())
  tenantId     String   @unique @map("tenant_id")
  legalName    String?  @map("legal_name")
  tradeName    String   @map("trade_name")
  document     String?
  timezone     String   @default("America/Sao_Paulo")
  locale       String   @default("pt-BR")
  currencyCode String   @default("BRL") @map("currency_code")
  agendaViewMode String @default("table") @map("agenda_view_mode")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model User {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  name          String
  email         String
  passwordHash  String    @map("password_hash")
  status        String    @default("active")
  deactivatedAt DateTime? @map("deactivated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant                       Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles                        UserRole[]
  permissionOverrides          UserPermissionOverride[]
  sessions                     Session[]
  passwordResetTokens          PasswordResetToken[]
  auditLogs                    AuditLog[]
  deletedCustomers             Customer[]                    @relation("CustomerDeletedByUser")
  deletedVehicles              Vehicle[]                     @relation("VehicleDeletedByUser")
  customerVehicleHistoryEvents CustomerVehicleHistoryEvent[] @relation("CustomerVehicleHistoryCreatedByUser")
  createdAppointments          Appointment[]                 @relation("AppointmentCreatedByUser")
  cancelledAppointments        Appointment[]                 @relation("AppointmentCancelledByUser")
  createdReceptionCheckIns     ReceptionCheckIn[]            @relation("ReceptionCheckInCreatedByUser")
  updatedReceptionCheckIns     ReceptionCheckIn[]            @relation("ReceptionCheckInUpdatedByUser")
  uploadedCheckInAttachments   CheckInAttachment[]           @relation("CheckInAttachmentUploadedByUser")
  deletedCheckInAttachments    CheckInAttachment[]           @relation("CheckInAttachmentDeletedByUser")

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([email])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  permissionId String   @map("permission_id")
  effect       String
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([permissionId])
  @@map("user_permission_overrides")
}

model Session {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  lastUsedAt       DateTime? @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([refreshTokenHash])
  @@index([tenantId, userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([codeHash])
  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id")
  userId    String?  @map("user_id")
  action    String
  entity    String
  recordId  String?  @map("record_id")
  payload   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@index([entity, recordId])
  @@map("audit_logs")
}

model Customer {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  name               String
  document           String?
  documentNormalized String?   @map("document_normalized")
  documentType       String?   @map("document_type")
  phone              String?
  phoneNormalized    String?   @map("phone_normalized")
  email              String?
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  deletedByUserId    String?   @map("deleted_by_user_id")

  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletedByUser User?                         @relation("CustomerDeletedByUser", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  vehicles      Vehicle[]
  historyEvents CustomerVehicleHistoryEvent[]
  appointments  Appointment[]
  checkIns      ReceptionCheckIn[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, name])
  @@index([tenantId, documentNormalized])
  @@index([tenantId, phoneNormalized])
  @@map("customers")
}

model Vehicle {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  customerId      String    @map("customer_id")
  plate           String?
  plateNormalized String?   @map("plate_normalized")
  vin             String?
  vinNormalized   String?   @map("vin_normalized")
  brand           String?
  model           String?
  year            Int?
  color           String?
  mileage         Int?
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedByUserId String?   @map("deleted_by_user_id")

  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer                      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  deletedByUser User?                         @relation("VehicleDeletedByUser", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  historyEvents CustomerVehicleHistoryEvent[]
  appointments  Appointment[]
  checkIns      ReceptionCheckIn[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, customerId])
  @@index([tenantId, plateNormalized])
  @@index([tenantId, vinNormalized])
  @@map("vehicles")
}

model CustomerVehicleHistoryEvent {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  customerId      String?  @map("customer_id")
  vehicleId       String?  @map("vehicle_id")
  type            String
  summary         String
  metadata        Json?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle       Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdByUser User?     @relation("CustomerVehicleHistoryCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([customerId, createdAt])
  @@index([vehicleId, createdAt])
  @@index([type])
  @@map("customer_vehicle_history_events")
}

model ServiceCatalogEntry {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  name                String
  description         String?
  basePrice           Decimal   @map("base_price") @db.Decimal(12, 2)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deactivatedAt       DateTime? @map("deactivated_at")
  deactivatedByUserId String?   @map("deactivated_by_user_id")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, deactivatedAt])
  @@index([tenantId, name])
  @@map("service_catalog_entries")
}

model ProductCategory {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  name                String
  description         String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deactivatedAt       DateTime? @map("deactivated_at")
  deactivatedByUserId String?   @map("deactivated_by_user_id")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId, deactivatedAt])
  @@index([tenantId, name])
  @@map("product_categories")
}

model Product {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  categoryId          String    @map("category_id")
  sku                 String?
  name                String
  description         String?
  salePrice           Decimal?  @map("sale_price") @db.Decimal(12, 2)
  costPrice           Decimal?  @map("cost_price") @db.Decimal(12, 2)
  minimumStock        Int       @default(0) @map("minimum_stock")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deactivatedAt       DateTime? @map("deactivated_at")
  deactivatedByUserId String?   @map("deactivated_by_user_id")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          ProductCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  stock             ProductStock?
  purchaseItems     PurchaseItem[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]

  @@index([tenantId, deactivatedAt])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])
  @@index([tenantId, sku])
  @@map("products")
}

model ProductStock {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  productId        String   @unique @map("product_id")
  physicalQuantity Int      @default(0) @map("physical_quantity")
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@map("product_stocks")
}

model Supplier {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  name                String
  document            String?
  documentNormalized  String?   @map("document_normalized")
  phone               String?
  phoneNormalized     String?   @map("phone_normalized")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deactivatedAt       DateTime? @map("deactivated_at")
  deactivatedByUserId String?   @map("deactivated_by_user_id")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([tenantId, deactivatedAt])
  @@index([tenantId, name])
  @@index([tenantId, documentNormalized])
  @@map("suppliers")
}

model Purchase {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  supplierId      String   @map("supplier_id")
  documentNumber  String?  @map("document_number")
  purchasedAt     DateTime @map("purchased_at")
  totalAmount     Decimal  @map("total_amount") @db.Decimal(12, 2)
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PurchaseItem[]

  @@index([tenantId, purchasedAt])
  @@index([tenantId, supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(cuid())
  tenantId   String  @map("tenant_id")
  purchaseId String  @map("purchase_id")
  productId  String  @map("product_id")
  quantity   Int
  unitCost   Decimal @map("unit_cost") @db.Decimal(12, 2)
  totalCost  Decimal @map("total_cost") @db.Decimal(12, 2)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchase      Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovement StockMovement?

  @@index([tenantId, purchaseId])
  @@index([tenantId, productId])
  @@map("purchase_items")
}

model StockMovement {
  id                    String   @id @default(cuid())
  tenantId              String   @map("tenant_id")
  productId             String   @map("product_id")
  purchaseItemId        String?  @unique @map("purchase_item_id")
  type                  String
  quantityDelta         Int      @map("quantity_delta")
  sourceKind            String   @map("source_kind")
  sourceId              String?  @map("source_id")
  sourceLabel           String?  @map("source_label")
  balanceAfterPhysical  Int      @map("balance_after_physical")
  balanceAfterReserved  Int      @map("balance_after_reserved")
  balanceAfterAvailable Int      @map("balance_after_available")
  createdByUserId       String?  @map("created_by_user_id")
  createdAt             DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseItem PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, sourceKind, sourceId])
  @@map("stock_movements")
}

model StockReservation {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  productId         String    @map("product_id")
  quantity          Int
  sourceKind        String    @map("source_kind")
  sourceId          String?   @map("source_id")
  sourceLabel       String?   @map("source_label")
  sourceReference   String?   @map("source_reference")
  status            String    @default("active")
  createdByUserId   String?   @map("created_by_user_id")
  cancelledByUserId String?   @map("cancelled_by_user_id")
  cancelledAt       DateTime? @map("cancelled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, productId, status])
  @@index([tenantId, sourceKind, sourceId])
  @@map("stock_reservations")
}

model Appointment {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  customerId        String    @map("customer_id")
  vehicleId         String    @map("vehicle_id")
  startsAt          DateTime  @map("starts_at")
  expectedService   String    @map("expected_service")
  notes             String?
  origin            String
  status            String    @default("Agendado")
  createdByUserId   String?   @map("created_by_user_id")
  cancelledByUserId String?   @map("cancelled_by_user_id")
  cancelledAt       DateTime? @map("cancelled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdByUser   User?    @relation("AppointmentCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelledByUser User?    @relation("AppointmentCancelledByUser", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  checkIn         ReceptionCheckIn?

  @@index([tenantId, startsAt])
  @@index([tenantId, status, startsAt])
  @@index([tenantId, customerId, startsAt])
  @@index([tenantId, vehicleId, startsAt])
  @@map("appointments")
}

model ReceptionCheckIn {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  appointmentId   String    @unique @map("appointment_id")
  customerId      String    @map("customer_id")
  vehicleId       String    @map("vehicle_id")
  enteredAt       DateTime  @map("entered_at")
  fuelLevel       String    @map("fuel_level")
  damageNotes     String    @map("damage_notes")
  mileage         Int?
  itemsLeft       String?   @map("items_left")
  status          String    @default("Aguardando diagnostico")
  createdByUserId String?   @map("created_by_user_id")
  updatedByUserId String?   @map("updated_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment   Appointment              @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  customer      Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle       Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdByUser User?                    @relation("ReceptionCheckInCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser User?                    @relation("ReceptionCheckInUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  checklist     ReceptionChecklistItem[]
  attachments   CheckInAttachment[]

  @@index([tenantId, enteredAt])
  @@index([tenantId, status, enteredAt])
  @@index([tenantId, customerId, enteredAt])
  @@index([tenantId, vehicleId, enteredAt])
  @@map("reception_check_ins")
}

model ReceptionChecklistItem {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  checkInId String   @map("check_in_id")
  label     String
  condition String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checkIn ReceptionCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([tenantId, checkInId])
  @@index([tenantId, label])
  @@map("reception_checklist_items")
}

model CheckInAttachment {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  checkInId        String    @map("check_in_id")
  category         String
  originalName     String    @map("original_name")
  storedName       String    @map("stored_name")
  relativePath     String    @map("relative_path")
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  uploadedByUserId String?   @map("uploaded_by_user_id")
  deletedAt        DateTime? @map("deleted_at")
  deletedByUserId  String?   @map("deleted_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checkIn        ReceptionCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  uploadedByUser User?            @relation("CheckInAttachmentUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  deletedByUser  User?            @relation("CheckInAttachmentDeletedByUser", fields: [deletedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, checkInId, deletedAt])
  @@index([tenantId, category])
  @@index([tenantId, deletedAt])
  @@map("check_in_attachments")
}
